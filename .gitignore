gludd-dist.tar.gz

sandboxcom_github_rsa
sandboxcom_github_rsa.pub

# Private keys — never track. Generic patterns guard against new key files.
id_rsa
id_ed25519
id_ecdsa
id_dsa
*_rsa
*_ed25519
*_ecdsa
*.pem
*.key
*.p12
*.pfx

scripts/scan-secrets.py

# ── Terraform: never track state, plans, plugin cache, or real tfvars ─────────
# Phase 1 (TERRAFORM_INFRA_STRUCTURE.md §8) requires these before any .tf lands.
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
.terraform.lock.hcl
# Shared plugin cache: provider binaries downloaded once via TF_PLUGIN_CACHE_DIR
# (make tf-cache-warm / tf-init). Keep the dir (.gitkeep) but never the binaries.
infra/terraform/.plugin-cache/*
!infra/terraform/.plugin-cache/.gitkeep
# Real tfvars carry secrets; only *.tfvars.example is committed (negated below).
*.tfvars
!*.tfvars.example

# Z.AI / GLM API key material — never track (.zai.key also matches *.key above)
zai.api
.zai.key
zai.key

/tmp/
web_retriever/

# ── Claude Code harness: transient / machine-local items ─────────────────────
# Committed (safe to track): .claude/hooks/  .claude/settings.json  .claude/workflows/
# Ignored (transient or machine-local):
.claude/worktrees/          # agent git worktrees (~320MB venv each; huge + ephemeral)
.claude/statsig/            # telemetry / machine-local SDK state
.claude/todos/              # machine-local task state
.claude/shell-snapshots/    # machine-local shell history snapshots
.claude/projects/           # machine-local project memory
.claude/settings.local.json # machine-local permission overrides (keep settings.json)
web_retriever/

# ─────────────────────────────────────────────────────────────────────────────

# ── Terraform — never check in runtime state or real tfvars ──────────────────
# Per TERRAFORM_INFRA_STRUCTURE.md §8: .tfstate / .tfplan / .terraform/ / real
# *.tfvars MUST be ignored before any stack is checked in. *.tfvars.example is
# the only tfvars-shaped file that should ever be tracked.
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
*.tfvars
!*.tfvars.example
# ─────────────────────────────────────────────────────────────────────────────
