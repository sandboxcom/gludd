# dist/ is HALF-TRACKED: hand-authored build INPUTS are committed (install.sh,
# README.md, general-ludd.service, debian/control, rpm/gludd.spec,
# windows/gludd.nsi) because `make dist` / deb-package / rpm-package /
# windows-installer read them — a fresh clone cannot build the release matrix
# without them. Build OUTPUTS are ignored below. Do not blanket-ignore dist/.
dist/gludd
dist/general-ludd-agent-*
dist/build/
dist/deb-root/
dist/binaries/
dist/dmg-staging/
dist/gludd_*.deb
dist/gludd_*.deb.sha256
dist/gludd-*.rpm
dist/gludd-*.rpm.sha256
dist/gludd-*.dmg
dist/gludd-*.dmg.sha256
dist/gludd-*setup*.exe
dist/gludd-*setup*.exe.sha256
dist/*.tar.gz
dist/*.tar.gz.sha256
dist/SHA256SUMS
dist/sbom-test.json
dist/*.json
build/
*.egg-info/
.gate-failed
.gate-status
.gate-status.next
.gate-status.running
.gate-lite-status
.gate-lite-failed
.gate-background.pid
.watchdog.pid
.gate-logs/
.ci-status
ci-attempt-logs/
.test-summary
.secrets.baseline
.game-audit-report.json
research_effectiveness.json
# Approved gameplay references are locally cached, provenance-verified media.
.cache/gludd-game-e2e/

gludd-dist.tar.gz

sandboxcom_github_rsa
sandboxcom_github_rsa.pub

# Private keys — never track. Generic patterns guard against new key files.
id_rsa
id_ed25519
id_ecdsa
id_dsa
*_rsa
*_ed25519
*_ecdsa
*.pem
*.key
*.p12
*.pfx

scripts/scan-secrets.py

# ── Terraform: never track state, plans, plugin cache, or real tfvars ─────────
# Phase 1 (TERRAFORM_INFRA_STRUCTURE.md §8) requires these before any .tf lands.
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
.terraform.lock.hcl
# Shared plugin cache: provider binaries downloaded once via TF_PLUGIN_CACHE_DIR
# (make tf-cache-warm / tf-init). Keep the dir (.gitkeep) but never the binaries.
infra/terraform/.plugin-cache/*
!infra/terraform/.plugin-cache/.gitkeep
# Real tfvars carry secrets; only *.tfvars.example is committed (negated below).
*.tfvars
!*.tfvars.example

# API and SSH key material — never track (also matched by *.key / *_rsa above)
.deepseek.key
.zai.key
zai.key
zai.api
sandboxcom_github_rsa

/tmp/
web_retriever/*
!web_retriever/.gitkeep

Makefile.tmp

# Junk artifact from accidental database URI used as filename
sqlite+aiosqlite:

# ── OpenCode backup directory (debug artifact after crash recovery) ─────────
# ── Vim swap files ──────────────────────────────────────────────────────────
# Standard naming: .file.swp, .file.swo (dot-prefixed swap files for any file)
.*.sw?
*.sw?

.opencode.orig/
opencode.json.orig

# ── Claude Code harness: transient / machine-local items ─────────────────────
# Committed (safe to track): .claude/hooks/  .claude/settings.json  .claude/workflows/
# Ignored (transient or machine-local):
.claude/worktrees/          # agent git worktrees (~320MB venv each; huge + ephemeral)
.claude/statsig/            # telemetry / machine-local SDK state
.claude/todos/              # machine-local task state
.claude/shell-snapshots/    # machine-local shell history snapshots
.claude/projects/           # machine-local project memory
.claude/settings.local.json # machine-local permission overrides (keep settings.json)
web_retriever/*
!web_retriever/.gitkeep

# ─────────────────────────────────────────────────────────────────────────────

# ── Terraform — never check in runtime state or real tfvars ──────────────────
# Per TERRAFORM_INFRA_STRUCTURE.md §8: .tfstate / .tfplan / .terraform/ / real
# *.tfvars MUST be ignored before any stack is checked in. *.tfvars.example is
# the only tfvars-shaped file that should ever be tracked.
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
*.tfvars
!*.tfvars.example
# ─────────────────────────────────────────────────────────────────────────────

# Generated test/gate artifacts (never tracked, never task-registered)
coverage.json
test.db
nonexistent_edge_case_999.db
