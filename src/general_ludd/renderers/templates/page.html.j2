<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ output.title }}</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 2rem auto; max-width: 960px; color: #222; }
    h1, h2, h3 { line-height: 1.25; }
    .markdown { margin: 1rem 0; }
    .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin: 1rem 0; }
    .metrics div.metric { padding: 1rem; border: 1px solid #e2e2e2; border-radius: 6px; background: #fafafa; }
    .metrics div.metric span.label { display: block; font-size: 0.85rem; text-transform: uppercase; color: #666; }
    .metrics div.metric span.value { display: block; font-size: 1.4rem; font-weight: 600; margin-top: 0.25rem; }
    .raw-html { margin: 1rem 0; }
    footer { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #eee; color: #888; font-size: 0.85rem; }
  </style>
</head>
<body>
  <h1>{{ output.title }}</h1>

  {% for section in output.sections %}
    {% if section.type == "markdown" %}
      <div class="markdown">{{ section.body }}</div>
    {% elif section.type == "metric_grid" %}
      <div class="metrics">
        {% for m in section.metrics %}
          <div class="metric">
            <span class="label">{{ m.label }}</span>
            <span class="value">{{ m.value }}</span>
          </div>
        {% endfor %}
      </div>
    {% elif section.type == "raw_html" %}
      <div class="raw-html">{{ section.html | safe }}</div>
    {% endif %}
  {% endfor %}

  <footer>
    Rendered by general_ludd playbook web renderer.
    {% if output.metadata %}
    <pre>{{ output.metadata | tojson(indent=2) }}</pre>
    {% endif %}
  </footer>
</body>
</html>
