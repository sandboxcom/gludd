#!/usr/bin/env bash
# Pre-commit hook: validates .github/workflows/build.yml YAML syntax.
# Catches at commit time (rather than push/CI time):
#   - Unquoted !cancelled() / !github.* YAML tags (parse as tags -> 0s failure)
#   - Bad indentation / malformed YAML
#   - Circular job dependencies
#   - Build/release jobs depending on test-shard
#
# Usage:
#   pre-commit-workflow-yaml [path/to/build.yml]
#
# When no argument is given, validates the canonical
# .github/workflows/build.yml. The optional path arg is used by the test
# suite to feed malformed YAML without touching the real workflow file.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
YML_PATH="${1:-$ROOT_DIR/.github/workflows/build.yml}"

if [ ! -f "$YML_PATH" ]; then
    echo "SKIP-workflow-yaml: $YML_PATH not found" >&2
    exit 0
fi

exit_code=0

# --- Layer 1: raw YAML parse + unquoted-tag scan ----------------------------
# safe_load rejects custom tags (!cancelled(), !env, etc.) and indentation
# errors. We ALSO scan for unquoted !cancelled() / !github.* in if: conditions
# because PyYAML treats `if: foo() && !cancelled()` as a plain scalar string
# (the && makes the RHS a string), so safe_load does NOT catch it — but GitHub
# Actions' parser does, and fails the run in <1s. This mirrors the structural
# test TestWorkflowYamlIsValid::test_no_bang_cancelled_outside_quotes.
python3 - "$YML_PATH" <<'PYEOF' || exit_code=$?
import re
import sys
import yaml

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as fh:
    src = fh.read()

# 1a. Raw YAML parse — catches indentation and explicit-tag errors.
try:
    yaml.safe_load(src)
except yaml.YAMLError as exc:
    print(f"workflow-yaml: YAML PARSE ERROR in {path}:", exc, file=sys.stderr)
    sys.exit(1)

# 1b. Unquoted !cancelled() / !github.* tag scan. These look like YAML tags to
# GHA's parser even when PyYAML treats them as scalar-string characters.
# Quoted forms ('if: "..."') are safe; only bare `if: ... !tag()` is rejected.
tag_re = re.compile(r"^\s*if:\s+(?!['\"])(?=.*!Cancelled\(\)|.*!cancelled\(\)|.*!GitHub\w*\.|.*!github\w*\.)")
for lineno, line in enumerate(src.splitlines(), start=1):
    if tag_re.match(line):
        print(
            f"workflow-yaml: UNQUOTED TAG in {path}:{lineno}: {line.strip()!r} — "
            "GitHub Actions parses !cancelled() / !github.* as a YAML tag. "
            "Quote the condition: if: \"... && !cancelled()\"",
            file=sys.stderr,
        )
        sys.exit(1)
PYEOF

if [ "$exit_code" -ne 0 ]; then
    echo "workflow-yaml: layer 1 (YAML parse) failed for $YML_PATH" >&2
    exit "$exit_code"
fi

# --- Layer 2: structural pytest checks --------------------------------------
# Only run when validating the canonical build.yml. For ad-hoc path args
# (used by tests), the pytest layer is skipped because the structural tests
# read from the canonical BUILD_YML constant.
if [ "$YML_PATH" = "$ROOT_DIR/.github/workflows/build.yml" ]; then
    cd "$ROOT_DIR"
    uv run python -m pytest \
        tests/unit/test_release_pipeline_structure.py \
        -q --no-header --tb=short -p no:cacheprovider \
        >/dev/null 2>&1 || exit_code=$?
    if [ "$exit_code" -ne 0 ]; then
        echo "workflow-yaml: layer 2 (structural pytest) failed — run:" >&2
        echo "  make test-specific TESTFILE='tests/unit/test_release_pipeline_structure.py'" >&2
        exit "$exit_code"
    fi
fi

echo "workflow-yaml: OK ($YML_PATH)"
exit 0
