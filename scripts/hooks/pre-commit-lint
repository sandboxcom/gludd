#!/usr/bin/env bash
# Pre-commit hook: runs `make lint` to catch lint errors at commit time
# rather than at push/CI time.
#
# Install with `make install-hooks`.  The installer keeps pre-commit's generated
# hook beside this wrapper as `pre-commit.framework`; this script delegates to
# it after the project lint gate passes.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" && [ -f "$REPO_ROOT/Makefile" ]; then
    MAKEFILE="$REPO_ROOT/Makefile"
else
    REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
    MAKEFILE="$REPO_ROOT/Makefile"
fi

if [ ! -f "$MAKEFILE" ]; then
    echo "pre-commit-lint: ERROR — Makefile not found at $MAKEFILE" >&2
    echo "pre-commit-lint: cannot run 'make lint'. Aborting commit." >&2
    exit 1
fi

echo "pre-commit-lint: running 'make lint'..."
if ! make -C "$REPO_ROOT" lint; then
    echo "" >&2
    echo "pre-commit-lint: FAILED — lint errors detected." >&2
    echo "pre-commit-lint: fix the errors above, then re-run your commit." >&2
    echo "pre-commit-lint: bypass with 'git commit --no-verify' (not recommended)." >&2
    exit 1
fi

echo "pre-commit-lint: OK — lint passed."
FRAMEWORK_HOOK="${BASH_SOURCE[0]}.framework"
if [ -x "$FRAMEWORK_HOOK" ]; then
    echo "pre-commit-lint: delegating to the pre-commit framework..."
    exec "$FRAMEWORK_HOOK" "$@"
fi

exit 0
