{
  "legacy_floor_literal": {
    "CLAUDE_AGENT_FLOOR": "5"
  },
  "env": {
    "CLAUDE_AGENT_FLOOR": "10",
    "CLAUDE_AGENT_CEILING": "16",
    "GLUDD_FORCE_DELEGATE": "1",
    "GLUDD_FORCE_DELEGATE_GRACE": "5",
    "GLUDD_FORCE_DELEGATE_MAXBLOCK": "4",
    "GLUDD_NO_WAIT_ENFORCE": "1",
    "GLUDD_FLOOR_ENFORCE": "1",
    "GLUDD_FALSE_DONE_ENFORCE": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(make:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Task",
      "Agent",
      "ToolSearch",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "ScheduleWakeup",
      "SendMessage",
      "Monitor"
    ],
    "deny": [
      "Workflow",
      "AskUserQuestion"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/shawnwilson/gludd/.claude/hooks/session_start_orchestrate.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/shawnwilson/gludd/.claude/hooks/agent_floor_userprompt.sh"
          },
          {
            "type": "command",
            "command": "bash /Users/shawnwilson/gludd/.claude/hooks/agent_count_truth.sh"
          }
