  "normalization_examples": [
    {
      "name": "openjev-choice-normalization",
      "profile_id": "openjev-0.1-external-example",
      "upstream_request": {
        "model": "openjev-0.1",
        "state": "The dependency timed out once and recovered.",
        "questions": {
          "failure_kind": {
            "type": "choice",
            "instructions": "Classify the failure.",
            "criteria": {
              "configuration": "Configuration is invalid.",
              "transient": "A dependency failed temporarily.",
              "unknown": "Evidence is insufficient."
            }
          }
        }
      },
      "upstream_response": {
        "model": "openjev-0.1",
        "answers": {
          "failure_kind": {
            "choice": "transient",
            "probabilities": {
              "configuration": 0.1,
              "transient": 0.8,
              "unknown": 0.1
            },
            "confidence": 0.64
          }
        },
        "usage": {
          "input_tokens": 48,
          "output_tokens": 0
        }
      },
      "expected": [
        {
          "normalization_version": "gludd.typed-decision-normalization/v1",
          "request_id": "example-choice-1",
          "identity_fingerprint": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "task_kind": "failure_classification",
          "question_id": "failure_kind",
          "kind": "choice",
          "outcome": "transient",
          "probabilities": [
            {
              "label": "configuration",
              "probability": 0.1
            },
            {
              "label": "transient",
              "probability": 0.8
            },
            {
              "label": "unknown",
              "probability": 0.1
            }
          ],
          "upstream_confidence": 0.64,
          "disposition": "valid",
          "reason_code": null
        }
      ]
    },
