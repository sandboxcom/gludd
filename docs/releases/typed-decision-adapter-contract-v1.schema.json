{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gludd.dev/schemas/typed-decision-adapter-contract-v1.schema.json",
  "title": "Gludd typed-decision adapter contract examples",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles",
    "normalization_examples"
  ],
  "properties": {
    "$schema": {
      "const": "./typed-decision-adapter-contract-v1.schema.json"
    },
    "schema_version": {
      "const": "gludd.typed-decision-adapter-contract/v1"
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "normalization_examples": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/normalizationExample"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ownerSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility",
        "security",
        "evaluation",
        "lifecycle"
      ],
      "properties": {
        "compatibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "security": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "evaluation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lifecycle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "sourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "release",
        "commit",
        "source_archive_digest",
        "license",
        "reviewed_at"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "maxLength": 300
        },
        "release": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "source_archive_digest": {
          "$ref": "#/$defs/digest"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "contract_version",
        "backend_implementation",
        "backend_protocol_version",
        "endpoint_trust",
        "server_digest",
        "model_revision",
        "model_digest",
        "tokenizer_digest",
        "renderer_digest",
        "calibration_digest",
        "runtime_digest"
      ],
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "contract_version": {
          "const": "gludd.typed-decision/v1"
        },
        "backend_implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "backend_protocol_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "endpoint_trust": {
          "enum": [
            "hosted_https",
            "attested_local"
          ]
        },
        "server_digest": {
          "$ref": "#/$defs/digest"
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "model_digest": {
          "$ref": "#/$defs/digest"
        },
        "tokenizer_digest": {
          "$ref": "#/$defs/digest"
        },
        "renderer_digest": {
          "$ref": "#/$defs/digest"
        },
        "calibration_digest": {
          "$ref": "#/$defs/digest"
        },
        "runtime_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "model_id",
        "auth",
        "tls_required",
        "follow_redirects",
        "extensions"
      ],
      "properties": {
        "kind": {
          "enum": [
            "jev_http_external",
            "model_worker_jev_http"
          ]
        },
        "path": {
          "const": "/v1/systemone"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "not": {
            "pattern": "(^|[-_.])(latest|preview)($|[-_.])"
          }
        },
        "auth": {
          "enum": [
            "bearer_secret_reference",
            "model_worker_lease"
          ]
        },
        "tls_required": {
          "type": "boolean"
        },
        "follow_redirects": {
          "const": false
        },
        "extensions": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_types",
        "state_shapes",
        "max_state_bytes",
        "max_state_tokens",
        "max_questions",
        "max_choice_options",
        "max_score_levels",
        "truncation",
        "images",
        "confidence_semantics"
      ],
      "properties": {
        "question_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "choice",
              "noul",
              "score"
            ]
          }
        },
        "state_shapes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "string",
              "object",
              "array"
            ]
          }
        },
        "max_state_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_state_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_questions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_choice_options": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "max_score_levels": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "truncation": {
          "const": "reject_before_transport"
        },
        "images": {
          "const": false
        },
        "confidence_semantics": {
          "const": "upstream_advisory_only"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_bytes",
        "response_bytes",
        "concurrency",
        "queue_depth",
        "deadline_ms",
        "retry_attempts"
      ],
      "properties": {
        "request_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "queue_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 30000
        },
        "retry_attempts": {
          "const": 0
        }
      }
    },
    "batching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "max_batch_size",
        "max_wait_ms",
        "grouping_keys"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "grouping_keys": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity_fingerprint",
              "schema_version",
              "question_schema_digest",
              "token_budget",
              "calibration_digest",
              "trust_sensitivity_class",
              "deadline_bucket"
            ]
          }
        }
      }
    },
    "residency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "max_loaded_identities",
        "resident_byte_budget",
        "preload_identity_fingerprints"
      ],
      "properties": {
        "ownership": {
          "enum": [
            "external_endpoint",
            "universal_model_worker"
          ]
        },
        "max_loaded_identities": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "resident_byte_budget": {
          "type": "integer",
          "minimum": 0
        },
        "preload_identity_fingerprints": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sanitizer_digest",
        "fail_closed_before_send",
        "observer_mode",
        "result_mutation_allowed",
        "external_forwarding_allowed"
      ],
      "properties": {
        "sanitizer_digest": {
          "$ref": "#/$defs/digest"
        },
        "fail_closed_before_send": {
          "const": true
        },
        "observer_mode": {
          "const": "read_only"
        },
        "result_mutation_allowed": {
          "const": false
        },
        "external_forwarding_allowed": {
          "const": false
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization_version",
        "request_schema_versions",
        "response_schema_versions",
        "migration_mode",
        "unknown_major_action"
      ],
      "properties": {
        "normalization_version": {
          "const": "gludd.typed-decision-normalization/v1"
        },
        "request_schema_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "response_schema_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "migration_mode": {
          "enum": [
            "additive_or_new_identity",
            "new_identity_only"
          ]
        },
        "unknown_major_action": {
          "const": "reject"
        }
      }
    },
    "updatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owners",
        "check_cadence_days",
        "public_history_gate_days",
        "stable_release_gate",
        "independent_implementation_required",
        "manual_promotion_only",
        "reevaluate_on"
      ],
      "properties": {
        "owners": {
          "$ref": "#/$defs/ownerSet"
        },
        "check_cadence_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "public_history_gate_days": {
          "type": "integer",
          "minimum": 90
        },
        "stable_release_gate": {
          "type": "integer",
          "minimum": 2
        },
        "independent_implementation_required": {
          "const": true
        },
        "manual_promotion_only": {
          "const": true
        },
        "reevaluate_on": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source",
              "model",
              "tokenizer",
              "renderer",
              "calibration",
              "runtime",
              "endpoint_trust",
              "normalization",
              "redaction"
            ]
          }
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_state",
        "allowed_states",
        "max_canary_percent",
        "automatic_demotion",
        "prior_identity_fingerprint"
      ],
      "properties": {
        "initial_state": {
          "const": "disabled"
        },
        "allowed_states": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "disabled",
              "shadow",
              "canary_1",
              "canary_5",
              "canary_25"
            ]
          }
        },
        "max_canary_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "automatic_demotion": {
          "const": true
        },
        "prior_identity_fingerprint": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "example_only",
        "profile_state",
        "source_pin",
        "identity",
        "transport",
        "capabilities",
        "limits",
        "batching",
        "residency",
        "redaction",
        "compatibility",
        "update_policy",
        "rollout"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,79}$"
        },
        "example_only": {
          "type": "boolean"
        },
        "profile_state": {
          "enum": [
            "disabled",
            "shadow",
            "canary_1",
            "canary_5",
            "canary_25"
          ]
        },
        "source_pin": {
          "$ref": "#/$defs/sourcePin"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "transport": {
          "$ref": "#/$defs/transport"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "batching": {
          "$ref": "#/$defs/batching"
        },
        "residency": {
          "$ref": "#/$defs/residency"
        },
        "redaction": {
          "$ref": "#/$defs/redaction"
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "update_policy": {
          "$ref": "#/$defs/updatePolicy"
        },
        "rollout": {
          "$ref": "#/$defs/rollout"
        }
      }
    },
    "choiceQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instructions",
        "criteria"
      ],
      "properties": {
        "type": {
          "const": "choice"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "criteria": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "noulQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instructions"
      ],
      "properties": {
        "type": {
          "const": "noul"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "true",
            "false"
          ],
          "properties": {
            "true": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "false": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        }
      }
    },
    "scoreQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instructions",
        "criteria"
      ],
      "properties": {
        "type": {
          "const": "score"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "criteria": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "wireQuestion": {
      "oneOf": [
        {
          "$ref": "#/$defs/choiceQuestion"
        },
        {
          "$ref": "#/$defs/noulQuestion"
        },
        {
          "$ref": "#/$defs/scoreQuestion"
        }
      ]
    },
    "wireRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "state",
        "questions"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "state": {
          "type": [
            "string",
            "object",
            "array"
          ]
        },
        "questions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "$ref": "#/$defs/wireQuestion"
          }
        }
      }
    },
    "choiceAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice",
        "probabilities",
        "confidence"
      ],
      "properties": {
        "choice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "probabilities": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 20,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "noulAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noul"
      ],
      "properties": {
        "noul": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "scoreAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "legend",
        "probabilities",
        "confidence"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 9
        },
        "legend": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 10,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "probabilities": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 10,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "wireAnswer": {
      "oneOf": [
        {
          "$ref": "#/$defs/choiceAnswer"
        },
        {
          "$ref": "#/$defs/noulAnswer"
        },
        {
          "$ref": "#/$defs/scoreAnswer"
        }
      ]
    },
    "wireResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "answers",
        "usage"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "answers": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "$ref": "#/$defs/wireAnswer"
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "canonicalProbability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "probability"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "normalizedAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization_version",
        "request_id",
        "identity_fingerprint",
        "task_kind",
        "question_id",
        "kind",
        "outcome",
        "probabilities",
        "upstream_confidence",
        "disposition",
        "reason_code"
      ],
      "properties": {
        "normalization_version": {
          "const": "gludd.typed-decision-normalization/v1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]{1,128}$"
        },
        "identity_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "task_kind": {
          "const": "failure_classification"
        },
        "question_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "enum": [
            "choice",
            "noul",
            "score"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "boolean",
            "number"
          ]
        },
        "probabilities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/canonicalProbability"
          }
        },
        "upstream_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "disposition": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "normalizationExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "profile_id",
        "upstream_request",
        "upstream_response",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,79}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,79}$"
        },
        "upstream_request": {
