{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/qwen/qwen2.5-coder-32b-instruct",
  "small_model": "openrouter/google/gemma-3-27b-it",

  "agent": {
    "build": {
      "model": "deepseek/deepseek-chat"
    },
    "plan": {
      "model": "openrouter/google/gemma-3-27b-it"
    },
    "review": {
      "model": "openrouter/mistralai/mistral-small-3.1-24b-instruct"
    }
  },

  "provider": {
    "deepseek": {},
    "openrouter": {
      "models": {
        "google/gemma-3-27b-it": {},
        "qwen/qwen2.5-coder-32b-instruct": {},
        "deepseek/deepseek-chat": {},
        "mistralai/mistral-small-3.1-24b-instruct": {},
        "meta-llama/llama-4-scout-17b-16e-instruct": {}
      }
    }
  },

  "permission": {
    "bash": {
      "*": "deny",
      "make *": "allow"
    }
  },
  "plugin": [
    "./.opencode/plugin/enforce-make.ts",
    "./.opencode/plugin/enforce-floor.ts",
    "./.opencode/plugin/enforce-delegate.ts",
    "./.opencode/plugin/enforce-stop.ts",
    "./.opencode/plugin/enforce-session-start.ts",
    "./.opencode/plugin/enforce-deadline.ts",
    "./.opencode/plugin/enforce-todos.ts",
    "./.opencode/plugin/enforce-false-done.ts"
  ],
  "skills": {
    "paths": [".opencode/skills"]
  }
}
