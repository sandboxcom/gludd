{
  "version": 1,
  "targets": [
    {
      "name": "test-specific",
      "make_variables": ["TESTFILE", "PYTEST_ARGS"],
      "behavior": "make test-specific TESTFILE=tests/unit/test_make_target_contract.py::test_make_target_contract_is_valid PYTEST_ARGS=-q"
    },
    {
      "name": "test-files",
      "make_variables": ["TESTFILES", "PYTEST_ARGS"],
      "behavior": "make test-files TESTFILES=tests/unit/test_make_target_contract.py PYTEST_ARGS=-q"
    },
    {
      "name": "node-deps-sync",
      "make_variables": ["NODE_DEPS_VALIDATE_ONLY", "NODE_DEPS_NPM_USERCONFIG", "NODE_DEPS_NPM_CACHE", "NODE_DEPS_NPM_REGISTRY"],
      "behavior": "make node-deps-sync NODE_DEPS_VALIDATE_ONLY=1 NODE_DEPS_NPM_USERCONFIG=/dev/null NODE_DEPS_NPM_CACHE=/tmp/gludd-npm-cache-public-v1 NODE_DEPS_NPM_REGISTRY=https://registry.npmjs.org"
    },
    {
      "name": "node-deps-relock",
      "make_variables": ["NODE_DEPS_VALIDATE_ONLY", "NODE_DEPS_NPM_USERCONFIG", "NODE_DEPS_NPM_CACHE", "NODE_DEPS_NPM_REGISTRY"],
      "behavior": "make node-deps-relock NODE_DEPS_VALIDATE_ONLY=1 NODE_DEPS_NPM_USERCONFIG=/dev/null NODE_DEPS_NPM_CACHE=/tmp/gludd-npm-cache-public-v1 NODE_DEPS_NPM_REGISTRY=https://registry.npmjs.org"
    },
    {
      "name": "node-deps-audit",
      "make_variables": ["NODE_DEPS_VALIDATE_ONLY", "NODE_DEPS_NPM_USERCONFIG", "NODE_DEPS_NPM_CACHE", "NODE_DEPS_NPM_REGISTRY", "NODE_DEPS_AUDIT_LEVEL"],
      "behavior": "make node-deps-audit NODE_DEPS_VALIDATE_ONLY=1 NODE_DEPS_NPM_USERCONFIG=/dev/null NODE_DEPS_NPM_CACHE=/tmp/gludd-npm-cache-public-v1 NODE_DEPS_NPM_REGISTRY=https://registry.npmjs.org NODE_DEPS_AUDIT_LEVEL=moderate"
    },
    {
      "name": "provider-harness",
      "make_variables": ["PROVIDER", "LIVE"],
      "behavior": "make provider-harness PROVIDER=runpod LIVE=0"
    },
    {
      "name": "azure-harness",
      "make_variables": ["LIVE"],
      "environment_variables": ["AZURE_SUBSCRIPTION_ID", "AZURE_TENANT_ID"],
      "behavior": "make azure-harness LIVE=0 AZURE_SUBSCRIPTION_ID=sub-123 AZURE_TENANT_ID=tenant-456"
    },
    {
      "name": "test-e2e-azure-provision-sourced",
      "make_variables": ["AZURE_E2E_ENV_FILE", "AZURE_E2E_VALIDATE_ONLY"],
      "behavior": "make test-e2e-azure-provision-sourced AZURE_E2E_ENV_FILE=tests/fixtures/azure-e2e.env.example AZURE_E2E_VALIDATE_ONLY=1"
    },
    {
      "name": "test-e2e-games-provision",
      "make_variables": [
        "AZURE_E2E_ENV_FILE",
        "AZURE_E2E_VALIDATE_ONLY",
        "GAME_E2E_TIMEOUT_SECS",
        "GAME_E2E_REFERENCE_NETWORK",
        "GAME_E2E_REFERENCE_CACHE_DIR"
      ],
      "behavior": "make test-e2e-games-provision AZURE_E2E_ENV_FILE=tests/fixtures/azure-e2e.env.example AZURE_E2E_VALIDATE_ONLY=1 GAME_E2E_TIMEOUT_SECS=3600 GAME_E2E_REFERENCE_NETWORK=0 GAME_E2E_REFERENCE_CACHE_DIR=.cache/gludd-game-e2e"
    },
    {
      "name": "game-reference-preflight",
      "make_variables": [
        "GAME_E2E_REFERENCE_NETWORK",
        "GAME_E2E_REFERENCE_CACHE_DIR",
        "GAME_E2E_REFERENCE_VALIDATE_ONLY"
      ],
      "behavior": "make game-reference-preflight GAME_E2E_REFERENCE_NETWORK=0 GAME_E2E_REFERENCE_CACHE_DIR=.cache/gludd-game-e2e GAME_E2E_REFERENCE_VALIDATE_ONLY=1"
    },
    {
      "name": "test-e2e-games",
      "make_variables": ["PYTEST_ARGS"],
      "behavior": "make test-e2e-games PYTEST_ARGS='-q -k test_ssim_identity'"
    },
    {
      "name": "test-e2e-games-local",
      "make_variables": ["PYTEST_ARGS"],
      "behavior": "make test-e2e-games-local PYTEST_ARGS=-q"
    },
    {
      "name": "grep",
      "make_variables": ["Q", "SEARCH_PATH"],
      "behavior": "make grep Q=GAME_E2E SEARCH_PATH=docs"
    },
    {
      "name": "disk-reclaim",
      "make_variables": ["GLUDD_DISK_THRESHOLD"],
      "behavior": "make disk-reclaim GLUDD_DISK_THRESHOLD=101"
    },
    {
      "name": "uv-cache-prune-status",
      "make_variables": [],
      "behavior": "make uv-cache-prune-status"
    },
    {
      "name": "gate-refresh",
      "make_variables": ["GATE_REFRESH_VALIDATE_ONLY"],
      "behavior": "make gate-refresh GATE_REFRESH_VALIDATE_ONLY=1"
    },
    {
      "name": "triage-failures",
      "make_variables": ["LOG", "TRIAGE_STATE", "TRIAGE_FORMAT"],
      "behavior": "make triage-failures LOG=/dev/null TRIAGE_STATE=/tmp/gludd-triage-contract.json TRIAGE_FORMAT=json"
    },
    {
      "name": "gate-tail",
      "make_variables": ["GATE_TAIL_LINES"],
      "behavior": "make gate-tail GATE_TAIL_LINES=5"
    },
    {
      "name": "gate-lite-tail",
      "make_variables": ["GATE_TAIL_LINES"],
      "behavior": "make gate-lite-tail GATE_TAIL_LINES=5"
    },
    {
      "name": "azure-cleanup-e2e",
      "make_variables": [
        "AZURE_E2E_ENV_FILE",
        "AZURE_CLEANUP_TIMEOUT_SECS",
        "AZURE_CLEANUP_POLL_SECS",
        "AZURE_CLI"
      ],
      "behavior": "make azure-cleanup-e2e AZURE_E2E_ENV_FILE=tests/fixtures/azure-e2e.env.example AZURE_CLEANUP_TIMEOUT_SECS=1 AZURE_CLEANUP_POLL_SECS=1 AZURE_CLI=true"
    },
    {
      "name": "azure-cleanup-inspect",
      "make_variables": ["AZURE_E2E_ENV_FILE", "AZURE_CLI"],
      "behavior": "make azure-cleanup-inspect AZURE_E2E_ENV_FILE=tests/fixtures/azure-e2e.env.example AZURE_CLI=true"
    },
    {
      "name": "test-e2e-postgres-multiworker",
      "make_variables": [
        "POSTGRES_E2E_RUNTIME",
        "POSTGRES_E2E_IMAGE",
        "POSTGRES_E2E_TIMEOUT_SECS",
        "POSTGRES_E2E_VALIDATE_ONLY",
        "PODMAN_MACHINE",
        "PODMAN_START_TIMEOUT_SECS",
        "PODMAN_RECREATE",
        "PODMAN_MEMORY_MB",
        "PODMAN_CPUS",
        "PODMAN_DISK_GB"
      ],
      "behavior": "make test-e2e-postgres-multiworker POSTGRES_E2E_RUNTIME=true POSTGRES_E2E_IMAGE=postgres:16-alpine POSTGRES_E2E_TIMEOUT_SECS=1 POSTGRES_E2E_VALIDATE_ONLY=1 PODMAN_MACHINE=gludd PODMAN_START_TIMEOUT_SECS=1 PODMAN_RECREATE=0 PODMAN_MEMORY_MB=4096 PODMAN_CPUS=4 PODMAN_DISK_GB=20"
    },
    {
      "name": "podman-project-up",
      "make_variables": [
        "PODMAN_MACHINE",
        "PODMAN_START_TIMEOUT_SECS",
        "PODMAN_VALIDATE_ONLY"
      ],
      "behavior": "make podman-project-up PODMAN_MACHINE=gludd PODMAN_START_TIMEOUT_SECS=1 PODMAN_VALIDATE_ONLY=1"
    },
    {
      "name": "podman-project-recreate",
      "make_variables": [
        "PODMAN_MACHINE",
        "PODMAN_MEMORY_MB",
        "PODMAN_CPUS",
        "PODMAN_DISK_GB",
        "PODMAN_START_TIMEOUT_SECS",
        "PODMAN_VALIDATE_ONLY"
      ],
      "behavior": "make podman-project-recreate PODMAN_MACHINE=gludd-e2e PODMAN_MEMORY_MB=4096 PODMAN_CPUS=4 PODMAN_DISK_GB=20 PODMAN_START_TIMEOUT_SECS=30 PODMAN_VALIDATE_ONLY=1"
    },
    {
      "name": "podman-project-delete",
      "make_variables": [
        "PODMAN_MACHINE",
        "PODMAN_DELETE_TIMEOUT_SECS",
        "PODMAN_VALIDATE_ONLY"
      ],
      "behavior": "make podman-project-delete PODMAN_MACHINE=gludd-e2e PODMAN_DELETE_TIMEOUT_SECS=30 PODMAN_VALIDATE_ONLY=1"
    },
    {
      "name": "runpod-harness",
      "make_variables": ["LIVE"],
      "environment_variables": ["RUNPOD_API_KEY", "RUNPOD_BUDGET_USD"],
      "behavior": "make runpod-harness LIVE=0 RUNPOD_API_KEY=placeholder RUNPOD_BUDGET_USD=5"
    },
    {
      "name": "test-opa-policies",
      "make_variables": ["OPA_ARGS", "OPA_IMAGE"],
      "behavior": "make test-opa-policies OPA_ARGS=--strict OPA_IMAGE=openpolicyagent/opa:1.6.0"
    },
    {
      "name": "audit-coverage",
      "make_variables": ["THRESHOLD", "SOURCE"],
      "behavior": "make audit-coverage THRESHOLD=85 SOURCE=src/general_ludd"
    },
    {
      "name": "iam-headless-smoke",
      "make_variables": [],
