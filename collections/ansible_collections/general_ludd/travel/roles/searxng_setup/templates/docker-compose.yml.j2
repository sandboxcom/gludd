{# Docker Compose for SearXNG — generated by gludd searxng_setup role #}
version: "3.8"

services:
  searxng:
    image: searxng/searxng:latest
    container_name: gludd-searxng
    restart: unless-stopped
    ports:
      - "{{ searxng_port | default(8080) }}:8080"
    volumes:
      - "{{ searxng_config_dir | default('/etc/searxng') }}/settings.yml:/etc/searxng/settings.yml:ro"
      - searxng_data:/etc/searxng/data
    environment:
      - SEARXNG_SETTINGS_PATH=/etc/searxng/settings.yml
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  searxng_data:
