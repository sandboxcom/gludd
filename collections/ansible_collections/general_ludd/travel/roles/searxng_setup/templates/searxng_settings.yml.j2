{# SearXNG settings template for travel expert #}
# Generated by gludd searxng_setup role — {{ ansible_date_time.iso8601 }}
use_default_settings: true

general:
  instance_name: "Gludd Travel Search"
  debug: false
  privacypolicy_url: false
  contact_url: false
  enable_metrics: false

search:
  safe_search: {{ searxng_safe_search | default(0) }}
  autocomplete: "google"
  default_lang: "{{ searxng_default_lang | default('en') }}"
  formats:
    - html
    - json

server:
  secret_key: "{{ searxng_secret_key | default('CHANGE_ME_' + 99999999 | random | string) }}"
  bind_address: "0.0.0.0"
  port: {{ searxng_port | default(8080) }}
  limiter: false
  image_proxy: false
  method: "GET"
  public_instance: false

ui:
  static_use_hash: true
  default_theme: simple
  default_locale: en
  infinite_scroll: false
  center_alignment: false
  cache_url: false
  results_on_new_tab: false

engines:
  # --- General web search ---
  - name: google
    engine: google
    shortcut: g
    disabled: false

  - name: duckduckgo
    engine: duckduckgo
    shortcut: ddg
    disabled: false

  - name: wikipedia
    engine: wikipedia
    shortcut: wp
    disabled: false

  - name: wikivoyage
    engine: wikivoyage
    shortcut: wv
    disabled: false

  # --- Travel: Flights ---
  - name: google flights
    engine: google_flights
    shortcut: fl
    disabled: false
    categories: [general]

  - name: google travel
    engine: google_travel
    shortcut: tr
    disabled: false
    categories: [general]

  - name: kayak
    engine: kayak
    shortcut: kay
    disabled: false
    categories: [general]

  - name: skyscanner
    engine: skyscanner
    shortcut: sky
    disabled: false
    categories: [general]

  # --- Travel: Hotels ---
  - name: booking.com
    engine: booking
    shortcut: bk
    disabled: false
    categories: [general]

  - name: tripadvisor
    engine: tripadvisor
    shortcut: ta
    disabled: false
    categories: [general]

  - name: hotelscombined
    engine: hotelscombined
    shortcut: hc
    disabled: false
    categories: [general]

  - name: agoda
    engine: agoda
    shortcut: ag
    disabled: false
    categories: [general]

  - name: expedia
    engine: expedia
    shortcut: ex
    disabled: false
    categories: [general]

  # --- Travel: Events ---
  - name: google events
    engine: google_events
    shortcut: ev
    disabled: false
    categories: [general]

  - name: eventbrite
    engine: eventbrite
    shortcut: eb
    disabled: false
    categories: [general]

  - name: ticketmaster
    engine: ticketmaster
    shortcut: tm
    disabled: false
    categories: [general]

  # --- Travel: Maps & Locations ---
  - name: google maps
    engine: google_maps
    shortcut: gm
    disabled: false
    categories: [general]

  - name: openstreetmap
    engine: openstreetmap
    shortcut: osm
    disabled: false
    categories: [general]

  # --- Travel: Food ---
  - name: yelp
    engine: yelp
    shortcut: ye
    disabled: false
    categories: [general]

  # --- Images (travel photos) ---
  - name: google images
    engine: google_images
    shortcut: gi
    disabled: false
    categories: [images]

  - name: bing images
    engine: bing_images
    shortcut: bi
    disabled: false
    categories: [images]

  # --- News (travel news) ---
  - name: google news
    engine: google_news
    shortcut: gn
    disabled: false
    categories: [news]

outgoing:
  request_timeout: {{ searxng_request_timeout | default(5.0) }}
  max_request_timeout: {{ searxng_max_request_timeout | default(15.0) }}
  useragent_suffix: ""
  enable_http2: true
