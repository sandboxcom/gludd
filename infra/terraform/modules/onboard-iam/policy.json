{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2DescribeReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeImages",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeVolumes"
      ],
      "Resource": "arn:aws:ec2:*:*:*"
    },
    {
      "Sid": "Ec2MutateCompute",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:StartInstances",
        "ec2:StopInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${operator_region}",
          "ec2:InstanceType": [
            "p4d.24xlarge",
            "p4de.24xlarge",
            "p5.48xlarge"
          ]
        },
        "StringLike": {
          "aws:RequestedRegion": "${operator_region}",
          "ec2:InstanceType": [
            "g4dn.*",
            "g5.*",
            "g6.*",
            "p3.*",
            "p4d.*",
            "p5.*"
          ]
        }
      }
    },
    {
      "Sid": "Ec2MutateSecurityGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:*:*:*"
    },
    {
      "Sid": "Ec2MutateVolume",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume"
      ],
      "Resource": "arn:aws:ec2:*:*:volume/*"
    },
    {
      "Sid": "Ec2MutateEip",
      "Effect": "Allow",
      "Action": [
        "ec2:AllocateAddress",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress"
      ],
      "Resource": "arn:aws:ec2:*:*:*"
    },
    {
      "Sid": "Ec2MutateTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:*:*:*"
    },
    {
      "Sid": "IamPassRoleSelfOnly",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "${operator_role_arn}",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        },
        "StringEqualsIfExists": {
          "ec2:InstanceType": [
            "g4dn.xlarge",
            "g5.xlarge",
            "g5.2xlarge",
            "g5.4xlarge",
            "g5.12xlarge",
            "g6.xlarge",
            "p3.2xlarge",
            "p4d.24xlarge",
            "p5.48xlarge"
          ]
        }
      }
    },
    {
      "Sid": "CloudWatchLogsGluddOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/gludd/*"
    },
    {
      "Sid": "DenyIamEscalation",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateRole",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy"
      ],
      "Resource": "*"
    }
  ]
}
