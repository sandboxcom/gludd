# Example tfvars for an Azure Container Apps + vLLM stack.
# Real values never live here — placeholders only. At apply time the
# TerraformGenerator composer writes a real terraform.tfvars into a tempdir
# from ComputeConfig + SecretsManager (see TERRAFORM_INFRA_STRUCTURE.md §8).
#
# Copy to terraform.tfvars and fill in, OR pass via -var-file at apply time.

# Real serverless-GPU Container Apps inputs.
deployment_name = "d-example"
container_image = "vllm/vllm-openai:latest"
model_name      = "Qwen/Qwen2.5-0.5B-Instruct"
gpu_type        = "t4"
gpu_count       = 1
region          = "eastus"
allowed_cidr    = "203.0.113.10/32"
max_cost_usd    = 10
timeout_minutes = 15

vllm_context_length            = 4096
vllm_max_num_seqs              = 8
vllm_gpu_memory_utilization    = 0.9
vllm_enforce_eager             = false
vllm_enable_prefix_caching     = true
vllm_enable_chunked_prefill    = true
vllm_kv_cache_dtype            = "auto"
vllm_quantization              = ""

# Stack-only inputs (referenced by the stack's provider data sources, not by
# the module). Documented here so a full deployment is one -var-file away.
# azure_credentials (subscription_id / client_id / client_secret / tenant_id)
# are NOT included — they come from the standard Azure provider chain per
# SecretsManager, never tfvars.
